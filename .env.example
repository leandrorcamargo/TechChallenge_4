# ============================================================
# Tech4 — modelo de configuração
# Copie para .env (o setup faz isso se .env não existir) e preencha.
# NUNCA versione o .env.
# ============================================================

# ------------------------------------------------------------
# Dados — fonte da camada Gold usada pelo RAG
# ------------------------------------------------------------
# local (padrão): gera a Gold a partir do Bronze do repositório (retrieval/load_gold.py),
#                 sem precisar de credenciais AWS.
# s3:             baixa a Gold do bucket (exige as credenciais abaixo).
# GOLD_SOURCE=local

# AWS — usado pelos notebooks Databricks e por GOLD_SOURCE=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# S3 Bucket
S3_BUCKET=
BRONZE_PREFIX=db_bronze/
SILVER_PREFIX=db_silver/
GOLD_PREFIX=db_gold/

# ------------------------------------------------------------
# RAG — LLM local via Ollama (todos opcionais; valores padrão abaixo)
# ------------------------------------------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.8
# Modelo para a etapa de análise da pergunta (vazio = mesmo do OLLAMA_MODEL)
# OLLAMA_MODEL_ANALYZER=
# LLM_TEMPERATURE=0.1
# LLM_NUM_CTX=8192

# ------------------------------------------------------------
# RAG — Recuperação / seleção
# (o vector store e o modelo de embedding são definidos em retrieval/config.py)
# ------------------------------------------------------------
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# K_DENSE=40
# K_BM25=40
# K_FUSED=50
# TOP_N=12
# RERANK_THRESHOLD=-6.2   (calibrado: python eval/run_eval.py --calibrate)
# MIN_EVIDENCE=3
